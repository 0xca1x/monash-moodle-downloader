# Used to encrypt the saved Node CLI session blob at rest.
# Generate a long random value and keep it private.
MONASH_SESSION_SECRET=replace-with-a-long-random-secret

# Used by the batch subtitle translation command.
# Any OpenAI-compatible chat completions endpoint should work.
SUBTITLE_TRANSLATION_API_KEY=
SUBTITLE_TRANSLATION_BASE_URL=https://api.openai.com/v1
SUBTITLE_TRANSLATION_MODEL=
